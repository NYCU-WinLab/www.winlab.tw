KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Sign-in for /directory — a confidential OIDC client in the Keycloak realm,
# redirect URI <site>/api/auth/callback/keycloak. Runtime only.
KEYCLOAK_ISSUER=https://auth.winlab.tw/realms/winlab
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Encrypts the session cookie: openssl rand -base64 32
BETTER_AUTH_SECRET=

# OpenTelemetry — Sensorium observability producer (instrumentation.ts).
# Unset OTEL_EXPORTER_OTLP_ENDPOINT = no-op, no SDK registered.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=
